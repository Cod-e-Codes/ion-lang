// Channel worker: main sends job ids; a spawned thread sums them until disconnect.

enum Option<T> {
    Some(T);
    None;
}

enum SendResult<T> {
    Sent;
    Closed(T);
}

fn job_count() -> int {
    return 5;
}

fn send_jobs(tx: Sender<int>) {
    let mut next_job: int = 1;
    while next_job <= job_count() {
        send(&tx, next_job);
        next_job += 1;
    }
}

fn main() -> int {
    let (job_tx, job_rx): (Sender<int>, Receiver<int>) = channel<int>();
    let (done_tx, done_rx): (Sender<int>, Receiver<int>) = channel<int>();

    spawn {
        let mut rx: Receiver<int> = job_rx;
        let mut sum: int = 0;
        loop {
            match recv(&mut rx) {
                Option::Some(job) => {
                    sum += job;
                }
                Option::None => {
                    break;
                }
            }
        }
        send(&done_tx, sum);
    };

    send_jobs(job_tx);

    let mut done_rx_mut: Receiver<int> = done_rx;
    match recv(&mut done_rx_mut) {
        Option::Some(total) => {
            if total != 15 {
                return 1;
            }
            return 0;
        }
        Option::None => {
            return 2;
        }
    }
}
