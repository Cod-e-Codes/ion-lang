import "catalog.ion" as catalog;
import "stdlib/fmt.ion" as fmt;
import "stdlib/io.ion" as io;

fn main() -> int {
    let lines: int = catalog::catalog_line_count();
    let units: int = catalog::catalog_units_in_stock();
    let total: int = catalog::catalog_grand_total();

    io::println("catalog report");
    io::print("lines: ");
    fmt::println_int(lines);
    io::print("units: ");
    fmt::println_int(units);
    io::print("total cents: ");
    fmt::println_int(total);

    if lines != 3 {
        return 1;
    }
    if units != 17 {
        return 2;
    }
    if total != 5140 {
        return 3;
    }
    return 0;
}
