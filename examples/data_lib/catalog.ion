struct Product {
    unit_price: int;
    quantity: int;
}

enum Option<T> {
    Some(T);
    None;
}

fn catalog_rows() -> Vec<Product> {
    let mut rows: Vec<Product> = Vec::new();
    rows.push(Product { unit_price: 1200, quantity: 2 });
    rows.push(Product { unit_price: 350, quantity: 5 });
    rows.push(Product { unit_price: 99, quantity: 10 });
    return rows;
}

pub fn catalog_line_count() -> int {
    let rows: Vec<Product> = catalog_rows();
    return rows.len();
}

pub fn catalog_grand_total() -> int {
    let rows: Vec<Product> = catalog_rows();
    let mut total: int = 0;
    let mut i: int = 0;
    let n: int = rows.len();
    while i < n {
        match rows.get_ref(i) {
            Option::Some(product) => {
                total += product.unit_price * product.quantity;
            }
            Option::None => {
                return total;
            }
        }
        i += 1;
    }
    return total;
}

pub fn catalog_units_in_stock() -> int {
    let quantities: [int; 3] = [2, 5, 10];
    let mut units: int = 0;
    let mut i: int = 0;
    let n: int = quantities.len();
    while i < n {
        match quantities.get_ref(i) {
            Option::Some(qty) => {
                units += qty;
            }
            Option::None => {
                return units;
            }
        }
        i += 1;
    }
    return units;
}
