// Interactive todo list: Vec<Todo>, index search, get_ref peek, get/set put-back, loop REPL.

import "stdlib/io.ion" as io;
import "stdlib/result.ion" as result;

extern "C" {
    fn read(fd: int, buf: *u8, count: int) -> int;
}

enum Option<T> {
    Some(T);
    None;
}

enum ParseError {
    Bad;
}

struct Todo {
    id: int;
    label: String;
    done: bool;
}

struct AppState {
    items: Vec<Todo>;
    next_id: int;
}

fn read_line() -> String {
    let mut text: String = String::new();
    let mut byte_buf: [u8; 1] = [0; 1];

    loop {
        unsafe {
            let n: int = read(0, &byte_buf[0], 1);
            if n <= 0 {
                return text;
            }
        }
        let ch: u8 = byte_buf[0];
        if ch == 10 as u8 {
            return text;
        }
        if ch != 13 as u8 {
            text.push_byte(ch);
        }
    }

    return text;
}

fn trim_left(s: String) -> String {
    let mut out: String = String::new();
    let mut skipping: bool = true;
    for ch in s {
        if skipping && (ch == 32 || ch == 9) {
            continue;
        }
        skipping = false;
        out.push_byte(ch);
    }
    return out;
}

fn first_token(line: String) -> (String, String) {
    let mut verb: String = String::new();
    let mut rest: String = String::new();
    let mut past_space: bool = false;

    for ch in line {
        if !past_space {
            if ch == 32 || ch == 9 {
                past_space = true;
            } else {
                verb.push_byte(ch);
            }
        } else {
            rest.push_byte(ch);
        }
    }

    return (verb, rest);
}

fn parse_int(s: String) -> Result<int, ParseError> {
    let mut value: int = 0;
    let mut any: bool = false;

    for ch in s {
        if ch >= 48 && ch <= 57 {
            any = true;
            value = value * 10 + ((ch as int) - 48);
        } else if ch != 32 && ch != 9 {
            return Result::Err(ParseError::Bad);
        }
    }

    if !any {
        return Result::Err(ParseError::Bad);
    }
    return Result::Ok(value);
}

fn keep_todo(out: &mut Vec<Todo>, todo: Todo, keep: bool) {
    if keep {
        out.push(todo);
    } else {
        let _gone: Todo = todo;
    }
}

fn print_todo_line(id: int, label: String, done: bool) -> String {
    io::print_int(id);
    io::print(": ");
    let nbytes: int = label.len();
    unsafe {
        io::print_str(label.data, nbytes);
    }
    if done {
        io::println(" [done]");
    } else {
        io::println("");
    }
    return label;
}

fn find_todo_index(items: &mut Vec<Todo>, id: int) -> int {
    let mut i: int = 0;
    let n: int = Vec::len(items);
    while i < n {
        match Vec::get_ref(items, i) {
            Option::Some(item) => {
                if item.id == id {
                    return i;
                }
            }
            Option::None => {
                return -1;
            }
        };
        i += 1;
    }
    return -1;
}

fn show(items: &mut Vec<Todo>) {
    if Vec::len(items) == 0 {
        io::println("(empty)");
        return;
    }

    let mut i: int = 0;
    let n: int = Vec::len(items);
    while i < n {
        match Vec::get(items, i) {
            Option::Some(todo) => {
                let id: int = todo.id;
                let label: String = todo.label;
                let done: bool = todo.done;
                let kept_label: String = print_todo_line(id, label, done);
                let row: Todo = Todo {
                    id: id,
                    label: kept_label,
                    done: done,
                };
                Vec::set(items, i, row);
            }
            Option::None => {}
        };
        i += 1;
    }
}

fn complete_todo(items: &mut Vec<Todo>, id: int) {
    let idx: int = find_todo_index(items, id);
    if idx < 0 {
        return;
    }
    match Vec::get(items, idx) {
        Option::Some(todo) => {
            let tid: int = todo.id;
            let tlabel: String = todo.label;
            let row: Todo = Todo {
                id: tid,
                label: tlabel,
                done: true,
            };
            Vec::set(items, idx, row);
        }
        Option::None => {}
    };
}

fn remove_todo(items: &mut Vec<Todo>, id: int) {
    let mut kept: Vec<Todo> = Vec::new();
    loop {
        match Vec::pop(items) {
            Option::Some(item) => {
                let tid: int = item.id;
                let keep: bool = tid != id;
                let todo: Todo = Todo {
                    id: tid,
                    label: item.label,
                    done: item.done,
                };
                keep_todo(&mut kept, todo, keep);
            }
            Option::None => {
                break;
            }
        };
    }
    loop {
        match Vec::pop(&mut kept) {
            Option::Some(item) => {
                Vec::push(items, item);
            }
            Option::None => {
                break;
            }
        };
    }
}

fn print_help() {
    io::println("commands:");
    io::println("  list              show all todos");
    io::println("  add <label>       add a todo");
    io::println("  done <id>         mark todo done");
    io::println("  remove <id>       delete a todo");
    io::println("  help              show this help");
    io::println("  quit              exit");
}

fn handle_add(state: &mut AppState, arg: String) {
    let label: String = trim_left(arg);
    if label.len() == 0 {
        io::println("usage: add <label>");
        return;
    }
    state.items.push(Todo {
        id: state.next_id,
        label: label,
        done: false,
    });
    state.next_id += 1;
    io::println("added");
}

fn handle_done(state: &mut AppState, arg: String) {
    let id_text: String = trim_left(arg);
    match parse_int(id_text) {
        Result::Ok(id) => {
            complete_todo(state.items, id);
            io::println("marked done");
        }
        Result::Err(_) => {
            io::println("usage: done <id>");
        }
    }
}

fn handle_remove(state: &mut AppState, arg: String) {
    let id_text: String = trim_left(arg);
    match parse_int(id_text) {
        Result::Ok(id) => {
            remove_todo(state.items, id);
            io::println("removed");
        }
        Result::Err(_) => {
            io::println("usage: remove <id>");
        }
    }
}

fn handle_command(state: &mut AppState, verb: String, arg: String) {
    if verb == String::from("help") {
        print_help();
    } else if verb == String::from("?") {
        print_help();
    } else if verb == String::from("list") {
        show(state.items);
    } else if verb == String::from("add") {
        handle_add(state, arg);
        return;
    } else if verb == String::from("done") {
        handle_done(state, arg);
        return;
    } else if verb == String::from("remove") {
        handle_remove(state, arg);
        return;
    } else {
        io::println("unknown command (try help)");
    }
}

fn main() -> int {
    let mut state: AppState = AppState {
        items: Vec::new(),
        next_id: 1,
    };

    io::println("Ion todo demo (type help)");

    loop {
        io::print("todo> ");
        let line: String = read_line();
        let trimmed: String = trim_left(line);

        if trimmed.len() == 0 {
            continue;
        }

        let (verb, arg): (String, String) = first_token(trimmed);

        if verb == String::from("quit") {
            break;
        } else if verb == String::from("exit") {
            break;
        }

        handle_command(&mut state, verb, arg);
    }

    return 0;
}
