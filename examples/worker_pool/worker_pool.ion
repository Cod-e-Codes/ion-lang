// One job channel, cloned senders (MPSC), one consumer until disconnect.
enum Option<T> {
    Some(T);
    None;
}

enum SendResult<T> {
    Sent;
    Closed(T);
}

fn worker_count() -> int {
    return 3;
}

fn jobs_per_worker() -> int {
    return 4;
}

fn spawn_producer(worker_id: int, tx: Sender<int>) {
    spawn {
        let mut job_id: int = 1;
        while job_id <= jobs_per_worker() {
            let payload: int = worker_id * 100 + job_id;
            send(&tx, payload);
            job_id += 1;
        }
    };
}

fn discard_sender(tx: Sender<int>) {
}

fn main() -> int {
    let (job_tx, job_rx): (Sender<int>, Receiver<int>) = channel<int>(8);
    let (done_tx, done_rx): (Sender<int>, Receiver<int>) = channel<int>();

    spawn {
        let mut rx: Receiver<int> = job_rx;
        let mut sum: int = 0;
        loop {
            match recv(&mut rx) {
                Option::Some(job) => {
                    sum += job;
                }
                Option::None => {
                    break;
                }
            }
        }
        send(&done_tx, sum);
    };

    let mut w: int = 0;
    while w < worker_count() {
        let worker_id: int = w + 1;
        let tx: Sender<int> = clone_sender(&job_tx);
        spawn_producer(worker_id, tx);
        w += 1;
    }
    discard_sender(job_tx);

    let mut done_rx_mut: Receiver<int> = done_rx;
    match recv(&mut done_rx_mut) {
        Option::Some(grand_total) => {
            if grand_total != 2430 {
                return 1;
            }
            return 0;
        }
        Option::None => {
            return 2;
        }
    }
}
