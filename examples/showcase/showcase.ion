// Ion language showcase: current idioms.

import "stdlib/result.ion" as result;

enum Option<T> {
    Some(T);
    None;
}

enum DemoErr {
    Bad;
}

enum Status {
    Ok { value: int };
    Err { code: int };
}

struct Point {
    x: int;
    y: int;
}

struct Pair<T> {
    first: T;
    second: T;
}

struct Node {
    value: int;
    next: Option<Box<Node>>;
}

fn add(x: int, y: int) -> int {
    return x + y;
}

fn get_first<T>(pair: Pair<T>) -> T {
    return pair.first;
}

fn classify(x: int) -> Result<int, DemoErr> {
    if x < 0 {
        return Result::Err(DemoErr::Bad);
    }
    return Result::Ok(x);
}

fn box_example() -> int {
    let boxed = Box::new(Point { x: 10, y: 32 });
    let p = Box::unwrap(boxed);
    return p.x + p.y;
}

fn vec_example() -> int {
    let mut numbers: Vec<int> = Vec::new();
    numbers.push(10);
    numbers.push(20);
    numbers.push(30);

    if numbers.len() != 3 {
        return 1;
    }

    match numbers.get_ref(0) {
        Option::Some(value) => {
            if value != 10 {
                return 2;
            }
        }
        Option::None => {
            return 3;
        }
    }

    numbers.set(1, 25);

    match numbers.pop() {
        Option::Some(value) => {
            if value != 30 {
                return 4;
            }
        }
        Option::None => {
            return 5;
        }
    }

    return 0;
}

fn for_loop_example() -> int {
    let mut values: Vec<int> = Vec::new();
    values.push(1);
    values.push(2);
    values.push(3);

    let mut sum: int = 0;
    for v in values {
        sum += v;
    }
    if sum != 6 {
        return 1;
    }
    return 0;
}

fn string_example() -> int {
    let mut greeting: String = String::new();
    greeting.push_str("Hello");
    greeting.push_str(", ");
    greeting.push_str("Ion");
    greeting.push_byte(33 as u8);

    if greeting.len() != 11 {
        return 1;
    }

    let message: String = "Welcome to Ion";
    if message.len() != 14 {
        return 2;
    }

    match greeting.get(0) {
        Option::Some(b) => {
            if b != 72 as u8 {
                return 3;
            }
        }
        Option::None => {
            return 4;
        }
    }

    match greeting.get(99) {
        Option::Some(_) => {
            return 5;
        }
        Option::None => {}
    }

    return 0;
}

fn sum_slice(s: &[]int) -> int {
    let mut total: int = 0;
    let mut i: int = 0;
    let n: int = s.len();
    while i < n {
        match s.get_ref(i) {
            Option::Some(x) => {
                total += x;
            }
            Option::None => {
                return -1;
            }
        }
        i += 1;
    }
    return total;
}

fn slice_example() -> int {
    let a: [int; 2] = [10, 20];
    let b: [int; 4] = [1, 2, 3, 4];
    if sum_slice(&a) != 30 {
        return 1;
    }
    if sum_slice(&b) != 10 {
        return 2;
    }
    if Slice::len(&a) != 2 {
        return 3;
    }
    if a.len() != 2 {
        return 4;
    }
    return 0;
}

fn if_example() -> int {
    let cap: int = 10;
    if cap < 10 {
        return 1;
    }
    let len: int = 5;
    if len == 0 {
        return 2;
    }
    return 0;
}

fn while_example() -> int {
    let mut x: int = 0;
    while x < 3 {
        x += 1;
    }
    if x != 3 {
        return 1;
    }
    return 0;
}

fn control_flow_example() -> int {
    if if_example() != 0 {
        return 1;
    }
    if while_example() != 0 {
        return 2;
    }
    if for_loop_example() != 0 {
        return 3;
    }
    return 0;
}

fn pattern_matching_example() -> int {
    let opt = Option::Some(42);

    match opt {
        Option::Some(v) if v == 42 => {}
        Option::Some(_) => {
            return 1;
        }
        Option::None => {
            return 2;
        }
    }

    match classify(100) {
        Result::Ok(value) => {
            if value != 100 {
                return 3;
            }
        }
        Result::Err(_) => {
            return 4;
        }
    }

    match classify(-1) {
        Result::Ok(_) => {
            return 5;
        }
        Result::Err(_) => {}
    }

    let status = Status::Ok { value: 7 };
    match status {
        Status::Ok { value: v } => {
            if v != 7 {
                return 6;
            }
        }
        Status::Err { code: _c } => {
            return 7;
        }
    }

    return 0;
}

fn recursive_box_example() -> int {
    let empty: Option<Box<Node>> = Option::None;
    let leaf: Node = Node {
        value: 2,
        next: empty,
    };
    let boxed = Box::new(Node {
        value: 1,
        next: Option::Some(Box::new(leaf)),
    });
    let n = Box::unwrap(boxed);
    match n.next {
        Option::Some(child_box) => {
            let child = Box::unwrap(child_box);
            return n.value + child.value;
        }
        Option::None => {
            return 1;
        }
    }
}

fn reference_example() -> int {
    let mut x: int = 10;
    let y: int = 20;

    if true {
        let _ref_y: &int = &y;
        let _ref_x: &mut int = &mut x;
    }

    let mut values: Vec<int> = Vec::new();
    values.push(x);
    values.push(y);
    if values.len() != 2 {
        return 1;
    }
    return 0;
}

fn generic_example() -> int {
    let int_pair: Pair<int> = Pair { first: 10, second: 20 };
    if int_pair.first != 10 {
        return 1;
    }
    if get_first(int_pair) != 10 {
        return 2;
    }

    let opt_int = Option::Some(42);
    match opt_int {
        Option::Some(_) => {}
        Option::None => {
            return 3;
        }
    }

    let mut vec: Vec<int> = Vec::new();
    vec.push(1);
    vec.push(2);
    if vec.len() != 2 {
        return 4;
    }
    return 0;
}

fn tuple_example() -> int {
    let t: (int, int) = (3, 4);
    if t.0 != 3 || t.1 != 4 {
        return 1;
    }
    let (a, b) = t;
    if a != 3 || b != 4 {
        return 2;
    }
    return 0;
}

fn spawn_channel_example() -> int {
    let (tx, rx): (Sender<int>, Receiver<int>) = channel<int>();
    let (tx_back, rx_back): (Sender<int>, Receiver<int>) = channel<int>();

    spawn {
        let mut rx_mut: Receiver<int> = rx;
        let value: int = recv(&mut rx_mut);
        send(&tx_back, value);
    };

    send(&tx, 99);

    let mut rx_back_mut: Receiver<int> = rx_back;
    let result: int = recv(&mut rx_back_mut);
    if result != 99 {
        return 1;
    }
    return 0;
}

fn fn_literal_example() -> int {
    let twice: fn(int) -> int = fn(x: int) -> int {
        return x * 2;
    };
    if twice(21) != 42 {
        return 1;
    }
    return 0;
}

enum Op {
    Push { val: int };
    Add;
    Halt;
}

struct BytecodeVM {
    ip: int;
    stack: Vec<int>;
    code: Vec<Op>;
}

fn run_bytecode(vm: &mut BytecodeVM) -> int {
    loop {
        match vm.code.get_ref(vm.ip) {
            Option::Some(op) => {
                match op {
                    Op::Push { val: v } => {
                        vm.stack.push(v);
                        vm.ip += 1;
                    }
                    Op::Add => {
                        let b = match vm.stack.pop() {
                            Option::Some(v) => {
                                v;
                            }
                            Option::None => {
                                return 0;
                            }
                        };
                        let a = match vm.stack.pop() {
                            Option::Some(v) => {
                                v;
                            }
                            Option::None => {
                                return 0;
                            }
                        };
                        vm.stack.push(a + b);
                        vm.ip += 1;
                    }
                    Op::Halt => {
                        break;
                    }
                }
            }
            Option::None => {
                break;
            }
        }
    }
    return 0;
}

fn bytecode_vm_example() -> int {
    let mut vm: BytecodeVM = BytecodeVM {
        ip: 0,
        stack: Vec::new(),
        code: Vec::new(),
    };
    vm.code.push(Op::Push { val: 10 });
    vm.code.push(Op::Push { val: 32 });
    vm.code.push(Op::Add);
    vm.code.push(Op::Halt);
    run_bytecode(&mut vm);
    match vm.stack.pop() {
        Option::Some(n) => {
            if n != 42 {
                return 1;
            }
        }
        Option::None => {
            return 2;
        }
    }
    return 0;
}

fn main() -> int {
    let x: int = 10;
    let y: int = 20;
    let z: int = x + y;
    if z != 30 {
        return 100;
    }

    if box_example() != 42 {
        return 1;
    }
    if vec_example() != 0 {
        return 2;
    }
    if string_example() != 0 {
        return 3;
    }
    if control_flow_example() != 0 {
        return 4;
    }
    if pattern_matching_example() != 0 {
        return 5;
    }
    if reference_example() != 0 {
        return 6;
    }
    if generic_example() != 0 {
        return 7;
    }
    if tuple_example() != 0 {
        return 8;
    }
    if spawn_channel_example() != 0 {
        return 9;
    }
    if fn_literal_example() != 0 {
        return 10;
    }
    if bytecode_vm_example() != 0 {
        return 12;
    }
    if slice_example() != 0 {
        return 13;
    }
    if recursive_box_example() != 3 {
        return 14;
    }

    return 0;
}
