enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let arr: [int; 1] = [7];
    match Slice::get_ref(&arr, -1) {
        Option::Some(_) => {
            return 1;
        }
        Option::None => {}
    };
    match Slice::get_ref(&arr, 1) {
        Option::Some(_) => {
            return 2;
        }
        Option::None => {}
    };
    match Slice::get_ref(&arr, 0) {
        Option::Some(x) => {
            if x != 7 {
                return 3;
            }
        }
        Option::None => {
            return 4;
        }
    };
    return 0;
}
