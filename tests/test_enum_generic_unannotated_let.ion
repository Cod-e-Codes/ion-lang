// Unannotated let: Option::Some(42) must lower as Option<int>, not int.
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let x = Option::Some(42);
    match x {
        Option::Some(v) => {
            return v;
        }
        Option::None => {
            return 0;
        }
    }
}
