// Sender drop overlaps worker exit: recv until None, then the receiver drops.
enum Option<T> {
    Some(T);
    None;
}

enum SendResult<T> {
    Sent;
    Closed(T);
}

fn drop_sender(tx: Sender<int>) {
}

fn trial(n: int) -> int {
    let (tx, rx): (Sender<int>, Receiver<int>) = channel<int>();
    let (ack_tx, ack_rx): (Sender<int>, Receiver<int>) = channel<int>();
    send(&tx, n);
    spawn {
        let mut rx_mut: Receiver<int> = rx;
        let mut got: int = 0;
        loop {
            match recv(&mut rx_mut) {
                Option::Some(value) => {
                    got = value;
                }
                Option::None => {
                    break;
                }
            }
        }
        send(&ack_tx, got);
    };
    drop_sender(tx);
    let mut ack_rx_mut: Receiver<int> = ack_rx;
    match recv(&mut ack_rx_mut) {
        Option::Some(value) => {
            if value != n {
                return 1;
            }
            return 0;
        }
        Option::None => {
            return 2;
        }
    }
}

fn main() -> int {
    let mut i: int = 0;
    while i < 64 {
        let code: int = trial(i + 1);
        if code != 0 {
            return code;
        }
        i = i + 1;
    }
    return 47;
}
