// Tuple elements infer Option::None from the adjacent (Option<int>, int) type.
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let t: (Option<int>, int) = (Option::None, 3);
    match t.0 {
        Option::Some(_) => {
            return 1;
        }
        Option::None => {
            return t.1;
        }
    }
}
