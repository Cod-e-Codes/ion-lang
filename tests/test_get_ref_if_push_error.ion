// Vec::push in an if inside the get_ref arm, then a use of the binding (BorrowConflict).
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let mut v: Vec<int> = Vec::new();
    Vec::push(&mut v, 2);
    match Vec::get_ref(&v, 0) {
        Option::Some(x) => {
            if true {
                Vec::push(&mut v, 1);
            }
            if x != 2 {
                return 1;
            }
        }
        Option::None => {
            return 0;
        }
    }
    return 0;
}
