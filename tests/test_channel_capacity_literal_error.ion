enum Option<T> {
    Some(T);
    None;
}

enum SendResult<T> {
    Sent;
    Closed(T);
}

fn main() -> int {
    let (tx, rx): (Sender<int>, Receiver<int>) = channel<int>(0);
    send(&tx, 1);
    match recv(&mut rx) {
        Option::Some(v) => {
            return v;
        }
        Option::None => {
            return 0;
        }
    }
}
