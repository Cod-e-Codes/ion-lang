// Recursive Box node is not Eq (Box is not Eq), even though the cycle is representable.
enum Option<T> {
    Some(T);
    None;
}

struct Node {
    value: int;
    next: Option<Box<Node>>;
}

fn require_eq<T: Eq>(value: T) -> int {
    let _v: T = value;
    return 0;
}

fn main() -> int {
    let empty: Option<Box<Node>> = Option::None;
    let n: Node = Node {
        value: 1,
        next: empty,
    };
    return require_eq(n);
}
