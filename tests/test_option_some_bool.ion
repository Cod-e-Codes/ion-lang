// Annotated Option<bool> still accepts Some(true).
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let x: Option<bool> = Option::Some(true);
    match x {
        Option::Some(v) => {
            if v {
                return 1;
            }
            return 0;
        }
        Option::None => {
            return 2;
        }
    }
}
