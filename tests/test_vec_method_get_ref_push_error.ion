// v.push takes &mut Vec while v.get_ref is live (BorrowConflict).
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let mut v: Vec<int> = Vec::new();
    v.push(1);
    match v.get_ref(0) {
        Option::Some(x) => {
            v.push(2);
            return x;
        }
        Option::None => {
            return 0;
        }
    }
}
