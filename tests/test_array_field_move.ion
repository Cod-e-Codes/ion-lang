// Moving an array place copies the bytes and clears the source with memset.
struct Wrap {
    arr: [Box<int>; 2];
}

enum Holder {
    Hold([Box<int>; 2]);
}

fn take(a: [Box<int>; 2]) -> int {
    let x: int = Box::unwrap(a[0]);
    let y: int = Box::unwrap(a[1]);
    return x + y;
}

fn from_local() -> [Box<int>; 2] {
    let w: Wrap = Wrap {
        arr: [Box::new(1), Box::new(2)],
    };
    return w.arr;
}

fn from_param(w: Wrap) -> [Box<int>; 2] {
    return w.arr;
}

fn main() -> int {
    let w: Wrap = Wrap {
        arr: [Box::new(3), Box::new(4)],
    };
    let a: [Box<int>; 2] = w.arr;
    if Box::unwrap(a[0]) != 3 {
        return 1;
    }
    if Box::unwrap(a[1]) != 4 {
        return 2;
    }
    let w2: Wrap = Wrap {
        arr: [Box::new(5), Box::new(6)],
    };
    if take(w2.arr) != 11 {
        return 3;
    }
    let back: [Box<int>; 2] = from_local();
    if Box::unwrap(back[0]) + Box::unwrap(back[1]) != 3 {
        return 4;
    }
    let w3: Wrap = Wrap {
        arr: [Box::new(7), Box::new(8)],
    };
    let back2: [Box<int>; 2] = from_param(w3);
    if Box::unwrap(back2[0]) != 7 {
        return 5;
    }
    Box::unwrap(back2[1]);
    let mut rows: [[Box<int>; 2]; 1] = [[Box::new(9), Box::new(10)]];
    let row: [Box<int>; 2] = rows[0];
    if Box::unwrap(row[0]) + Box::unwrap(row[1]) != 19 {
        return 6;
    }
    let h: Holder = Holder::Hold([Box::new(11), Box::new(12)]);
    match h {
        Holder::Hold(payload) => {
            if Box::unwrap(payload[0]) + Box::unwrap(payload[1]) != 23 {
                return 7;
            }
        }
    }
    return 0;
}
