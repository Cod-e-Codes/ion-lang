// Annotated Option<int> still accepts Some(1).
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let x: Option<int> = Option::Some(1);
    match x {
        Option::Some(v) => {
            return v;
        }
        Option::None => {
            return 0;
        }
    }
}
