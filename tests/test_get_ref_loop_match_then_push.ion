// Inside a loop, the arm-local get_ref loan ends before the push after the match.
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let mut v: Vec<int> = Vec::new();
    Vec::push(&mut v, 7);
    let mut i: int = 0;
    while i < 2 {
        match Vec::get_ref(&v, 0) {
            Option::Some(x) => {
                if x != 7 {
                    return 1;
                }
            }
            Option::None => {
                return 2;
            }
        }
        Vec::push(&mut v, 8);
        i = i + 1;
    }
    return 0;
}
