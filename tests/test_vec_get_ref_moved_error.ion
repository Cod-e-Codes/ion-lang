// Vec::get_ref on a moved Vec is UseAfterMove, including as a match scrutinee.
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let mut v: Vec<int> = Vec::new();
    Vec::push(&mut v, 1);
    let _w = v;
    match Vec::get_ref(&v, 0) {
        Option::Some(_x) => {
            return 0;
        }
        Option::None => {
            return 1;
        }
    }
}
