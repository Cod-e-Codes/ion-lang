// Assigning a local to itself does not drop. Scope exit drops once.
enum Option<T> {
    Some(T);
    None;
}

enum SendResult<T> {
    Sent;
    Closed(T);
}

struct Guard {
    tx: Sender<int>;
}

impl Drop for Guard {
    fn drop(self: &mut Guard) {
        send(self.tx, 42);
    }
}

fn scoped(tx: Sender<int>) {
    let mut b: Box<Guard> = Box::new(Guard { tx: tx });
    b = b;
}

fn main() -> int {
    let (tx, rx): (Sender<int>, Receiver<int>) = channel<int>();
    scoped(tx);
    match recv(&mut rx) {
        Option::Some(v) => {
            return v;
        }
        Option::None => {
            return 1;
        }
    }
}
