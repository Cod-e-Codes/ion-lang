// Recursive Box node is Send (coinductive Send over the cycle).
enum Option<T> {
    Some(T);
    None;
}

struct Node {
    value: int;
    next: Option<Box<Node>>;
}

fn hold<T: Send>(value: T) -> T {
    return value;
}

fn main() -> int {
    let empty: Option<Box<Node>> = Option::None;
    let n: Node = Node {
        value: 9,
        next: empty,
    };
    let kept: Node = hold(n);
    return kept.value;
}
