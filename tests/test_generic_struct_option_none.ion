// Instantiating S<int> must emit Option_int from the substituted field type.
enum Option<T> {
    Some(T);
    None;
}

struct S<T> {
    x: Option<T>;
}

fn main() -> int {
    let s: S<int> = S { x: Option::None };
    match s.x {
        Option::None => {
            return 15;
        }
        Option::Some(_) => {
            return 1;
        }
    }
}
