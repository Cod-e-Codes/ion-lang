// Replacing a captured Guard drops the previous sender.
enum Option<T> {
    Some(T);
    None;
}

enum SendResult<T> {
    Sent;
    Closed(T);
}

struct Guard {
    tx: Sender<int>;
}

impl Drop for Guard {
    fn drop(self: &mut Guard) {
        send(self.tx, 1);
    }
}

fn main() -> int {
    let (tx1, rx): (Sender<int>, Receiver<int>) = channel<int>();
    let (tx2, _rx2): (Sender<int>, Receiver<int>) = channel<int>();
    let mut g: Guard = Guard { tx: tx1 };
    let f = fn() -> int {
        g = Guard { tx: tx2 };
        return 0;
    };
    let _n: int = f();
    match recv(&mut rx) {
        Option::Some(v) => {
            return v;
        }
        Option::None => {
            return 2;
        }
    }
}
