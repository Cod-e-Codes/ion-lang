// Every fall-through path reassigns r, so the next iteration's read is a new Slice loan.
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let keep: int = 1;
    let mut items: [int; 2] = [7, 0];
    let mut r: &int = &keep;
    let mut i: int = 0;
    while i < 2 {
        if r != 1 && r != 7 {
            return 1;
        }
        items[1] = 8;
        match Slice::get_ref(&items, 0) {
            Option::Some(x) => {
                r = x;
            }
            Option::None => {
                r = &keep;
            }
        }
        i = i + 1;
    }
    if r != 1 && r != 7 {
        return 2;
    }
    return items[1];
}
