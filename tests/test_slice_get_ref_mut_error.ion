// Indexed write on the root owner conflicts with an active Slice::get_ref shared borrow.
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let mut items: [int; 1] = [1];
    match Slice::get_ref(&items, 0) {
        Option::Some(_x) => {
            items[0] = 2;
        }
        Option::None => {}
    };
    return 0;
}
