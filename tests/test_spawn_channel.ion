// Cross-thread channel test: spawn receives on one thread, main sends and waits for result.
enum Option<T> {
    Some(T);
    None;
}

enum SendResult<T> {
    Sent;
    Closed(T);
}

fn main() -> int {
    let (tx, rx): (Sender<int>, Receiver<int>) = channel<int>();
    let (tx_back, rx_back): (Sender<int>, Receiver<int>) = channel<int>();

    spawn {
        let mut rx_mut: Receiver<int> = rx;
        match recv(&mut rx_mut) {
            Option::Some(value) => {
                send(&tx_back, value);
            }
            Option::None => {
                send(&tx_back, -1);
            }
        }
    };

    send(&tx, 42);

    let mut rx_back_mut: Receiver<int> = rx_back;
    match recv(&mut rx_back_mut) {
        Option::Some(result) => {
            if result == 42 {
                return 0;
            }
            return 1;
        }
        Option::None => {
            return 2;
        }
    }
}
