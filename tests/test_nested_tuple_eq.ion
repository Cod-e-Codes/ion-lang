struct Pair {
    xy: (int, int);
}

fn first<T>(p: (T, int)) -> T {
    return p.0;
}

fn main() -> int {
    let nested: ((int, int), int) = ((1, 2), 3);
    if nested.0.0 != 1 {
        return 1;
    }
    if nested.0.1 != 2 {
        return 2;
    }
    if nested.1 != 3 {
        return 3;
    }
    if nested != ((1, 2), 3) {
        return 4;
    }
    if nested == ((9, 2), 3) {
        return 5;
    }
    let p: Pair = Pair { xy: (4, 5) };
    if p.xy != (4, 5) {
        return 6;
    }
    let t: (int, int) = (7, 8);
    if first(t) != 7 {
        return 7;
    }
    return 0;
}
