// Annotated let: Box::new(StructLit) must use sizeof(Node), not sizeof(int).
// Multi-field so a wrong sizeof(int) would under-allocate.
struct Node {
    a: int;
    b: int;
    c: int;
    d: int;
}

fn main() -> int {
    let boxed: Box<Node> = Box::new(Node {
        a: 1,
        b: 2,
        c: 3,
        d: 4,
    });
    let n: Node = Box::unwrap(boxed);
    return n.a + n.b + n.c + n.d;
}
