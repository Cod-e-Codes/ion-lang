// Returned array elements infer Option::None from the function return type.
enum Option<T> {
    Some(T);
    None;
}

fn make() -> [Option<int>; 1] {
    return [Option::None];
}

fn main() -> int {
    let a = make();
    match a[0] {
        Option::Some(_) => {
            return 1;
        }
        Option::None => {
            return 12;
        }
    }
}
