fn main() -> int {
    let a: u8 = 0xaa;
    let b: u8 = 0xf0;

    let and_result: u8 = a & b;
    if and_result != 160 {
        return 1;
    }

    let or_result: u8 = a | b;
    if or_result != 250 {
        return 2;
    }

    let xor_result: u8 = a ^ b;
    if xor_result != 90 {
        return 3;
    }

    // Left shift wraps to the destination width.
    let x: u16 = 4660;
    let shift_amount: u16 = 4;
    let left: u16 = x << shift_amount;
    if left != 9024 {
        return 11;
    }

    let x2: u16 = 4096;
    let shift2: u16 = 3;
    let left2: u16 = x2 << shift2;
    if left2 != 32768 {
        return 4;
    }

    let right: u16 = x >> shift_amount;
    if right != 291 {
        return 5;
    }

    let port: u16 = 8080;
    let shift8: u16 = 8;
    let high_byte: u16 = port >> shift8;
    let mask: u16 = 255;
    let low_byte: u16 = port & mask;

    if high_byte != 31 {
        return 6;
    }
    if low_byte != 144 {
        return 7;
    }

    let narrowed: u8 = 0x12ff as u8;
    if narrowed != 0xff {
        return 10;
    }

    let test1: u16 = 4660;
    let shift4: u16 = 4;
    let test2: u16 = (test1 >> shift4) & 255;
    if test2 != 35 {
        return 8;
    }

    let i32_val: i32 = 305419896;
    let shift8_2: u16 = 8;
    let shifted: i32 = i32_val << shift8_2;

    let u32_a: u32 = 4294967295;
    let u32_b: u32 = 65535;
    let u32_and: u32 = u32_a & u32_b;
    if u32_and != 65535 {
        return 9;
    }

    return 0;
}
