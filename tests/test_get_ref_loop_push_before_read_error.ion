// r still holds the previous iteration's loan, so push before the next read conflicts.
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let keep: int = 1;
    let mut v: Vec<int> = Vec::new();
    Vec::push(&mut v, 7);
    let mut r: &int = &keep;
    let mut i: int = 0;
    while i < 2 {
        Vec::push(&mut v, 8);
        if r != 1 && r != 7 {
            return 1;
        }
        match Vec::get_ref(&v, 0) {
            Option::Some(x) => {
                r = x;
            }
            Option::None => {
                r = &keep;
            }
        }
        i = i + 1;
    }
    return 0;
}
