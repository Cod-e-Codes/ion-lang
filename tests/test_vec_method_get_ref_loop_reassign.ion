// Every fall-through path reassigns r, so the next iteration's read is a new method loan.
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let keep: int = 1;
    let mut v: Vec<int> = Vec::new();
    v.push(7);
    let mut r: &int = &keep;
    let mut i: int = 0;
    while i < 2 {
        if r != 1 && r != 7 {
            return 1;
        }
        v.push(8);
        match v.get_ref(0) {
            Option::Some(x) => {
                r = x;
            }
            Option::None => {
                r = &keep;
            }
        }
        i = i + 1;
    }
    if r != 1 && r != 7 {
        return 2;
    }
    return 0;
}
