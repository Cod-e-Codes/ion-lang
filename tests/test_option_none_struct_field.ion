// Option::None infers T from the struct field's expected type in the same expression.
enum Option<T> {
    Some(T);
    None;
}

struct Node {
    value: int;
    next: Option<Box<Node>>;
}

fn main() -> int {
    let leaf = Node {
        value: 2,
        next: Option::None,
    };
    match leaf.next {
        Option::None => {
            return 2;
        }
        Option::Some(_) => {
            return 1;
        }
    }
}
