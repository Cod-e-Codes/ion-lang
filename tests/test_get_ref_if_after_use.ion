// A get_ref binding used only before an if does not block push in that branch.
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let mut v: Vec<int> = Vec::new();
    Vec::push(&mut v, 7);
    match Vec::get_ref(&v, 0) {
        Option::Some(x) => {
            if x != 7 {
                return 1;
            }
            if true {
                Vec::push(&mut v, 8);
            }
        }
        Option::None => {
            return 2;
        }
    }
    return 0;
}
