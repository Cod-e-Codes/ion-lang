// An array element moved by the right-hand side is not dropped, for a literal or a variable index.
fn same(b: Box<int>) -> Box<int> {
    return b;
}

fn main() -> int {
    let mut a: [Box<int>; 2] = [Box::new(1), Box::new(2)];
    a[0] = same(a[0]);
    let i: int = 1;
    a[i] = same(a[i]);
    let x: int = Box::unwrap(a[0]);
    let y: int = Box::unwrap(a[1]);
    if x != 1 {
        return 1;
    }
    if y != 2 {
        return 2;
    }
    return 0;
}
