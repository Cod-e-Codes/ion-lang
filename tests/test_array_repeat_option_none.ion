// Repeat arrays infer Option::None from the adjacent [Option<int>; N] type.
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let a: [Option<int>; 1] = [Option::None; 1];
    match a[0] {
        Option::Some(_) => {
            return 1;
        }
        Option::None => {
            return 5;
        }
    }
}
