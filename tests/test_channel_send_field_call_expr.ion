enum Option<T> {
    Some(T);
    None;
}

enum SendResult<T> {
    Sent;
    Closed(T);
}

struct Pair {
    x: int;
    y: int;
}

fn make_pair() -> Pair {
    return Pair { x: 11, y: 22 };
}

fn main() -> int {
    let (tx, rx): (Sender<int>, Receiver<int>) = channel<int>();
    send(&tx, make_pair().x);
    match recv(&mut rx) {
        Option::Some(v) => {
            return v;
        }
        Option::None => {
            return 0;
        }
    }
}
