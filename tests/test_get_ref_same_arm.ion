// A get_ref binding's last read ends that loan, so push in the same arm is allowed.
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let mut v: Vec<int> = Vec::new();
    Vec::push(&mut v, 7);
    match Vec::get_ref(&v, 0) {
        Option::Some(x) => {
            if x != 7 {
                return 1;
            }
            Vec::push(&mut v, 8);
        }
        Option::None => {
            return 2;
        }
    }
    return 0;
}
