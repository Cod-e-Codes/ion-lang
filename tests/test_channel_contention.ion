// Four cloned senders, one receiver; disconnect after producers drop.
enum Option<T> {
    Some(T);
    None;
}

enum SendResult<T> {
    Sent;
    Closed(T);
}

fn producer_count() -> int {
    return 4;
}

fn spawn_producer(value: int, tx: Sender<int>) {
    spawn {
        send(&tx, value);
    };
}

fn discard_sender(tx: Sender<int>) {
}

fn main() -> int {
    let (tx, rx): (Sender<int>, Receiver<int>) = channel<int>(4);
    let mut i: int = 0;
    while i < producer_count() {
        let value: int = (i + 1) * 10;
        let tx_i: Sender<int> = clone_sender(&tx);
        spawn_producer(value, tx_i);
        i = i + 1;
    }
    discard_sender(tx);

    let mut rx_mut: Receiver<int> = rx;
    let mut sum: int = 0;
    loop {
        match recv(&mut rx_mut) {
            Option::Some(received) => {
                sum = sum + received;
            }
            Option::None => {
                break;
            }
        }
    }

    if sum != 100 {
        return 1;
    }
    return 73;
}
