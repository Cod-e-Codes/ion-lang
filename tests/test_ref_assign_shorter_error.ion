// r outlives inner, and read(r) runs after inner is gone.
struct S {
    v: int;
}

fn read(a: &S) -> int {
    return a.v;
}

fn main() -> int {
    let keep: S = S { v: 1 };
    let mut r: &S = &keep;
    if 1 == 1 {
        let inner: S = S { v: 5 };
        r = &inner;
    }
    return read(r);
}
