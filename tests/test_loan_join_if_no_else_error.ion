// An if without else may skip the reassignment, so the entry loan stays.
fn main() -> int {
    let mut v: Vec<int> = Vec::new();
    Vec::push(&mut v, 1);
    let o: Vec<int> = Vec::new();
    let mut x: &Vec<int> = &v;
    if false {
        x = &o;
    }
    Vec::push(&mut v, 2);
    return Vec::len(x);
}
