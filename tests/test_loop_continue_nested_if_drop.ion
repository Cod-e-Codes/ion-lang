// continue inside a nested if must drop `b` and `a`; fall-through still uses `a`.
fn main() -> int {
    let mut i: int = 0;
    let mut acc: int = 0;
    while i < 3 {
        let a: String = String::from("aa");
        if i == 1 {
            let b: String = String::from("bb");
            i = i + 1;
            continue;
        }
        acc = acc + String::len(&a);
        i = i + 1;
    }
    return acc;
}
