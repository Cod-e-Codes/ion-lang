// r still holds the previous iteration's Slice loan, so a write before the next read conflicts.
enum Option<T> {
    Some(T);
    None;
}

fn main() -> int {
    let keep: int = 1;
    let mut items: [int; 2] = [7, 0];
    let mut r: &int = &keep;
    let mut i: int = 0;
    while i < 2 {
        items[1] = 8;
        if r != 1 && r != 7 {
            return 1;
        }
        match Slice::get_ref(&items, 0) {
            Option::Some(x) => {
                r = x;
            }
            Option::None => {
                r = &keep;
            }
        }
        i = i + 1;
    }
    return 0;
}
