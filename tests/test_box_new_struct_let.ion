// Unannotated let: IR must type StructLit as Node so Box::new is Box<Node>.
struct Node {
    a: int;
    b: int;
    c: int;
    d: int;
}

fn main() -> int {
    let boxed = Box::new(Node {
        a: 1,
        b: 2,
        c: 3,
        d: 4,
    });
    let n: Node = Box::unwrap(boxed);
    return n.a + n.b + n.c + n.d;
}
