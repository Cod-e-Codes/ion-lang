// Split Channel API (Sender<T> / Receiver<T>)
enum Option<T> {
    Some(T);
    None;
}

enum SendResult<T> {
    Sent;
    Closed(T);
}

fn main() -> int {
    let (tx, rx): (Sender<int>, Receiver<int>) = channel<int>();
    send(&tx, 42);

    let mut rx_mut: Receiver<int> = rx;
    match recv(&mut rx_mut) {
        Option::Some(value) => {
            if value == 42 {
                return 0;
            }
            return 1;
        }
        Option::None => {
            return 2;
        }
    }
}
