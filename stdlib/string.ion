import "option.ion" as option;

pub fn slice(s: &String, start: int, end: int) -> String {
    let mut bytes: Vec<u8> = Vec::new();
    let mut i: int = start;
    while i < end {
        match String::get(s, i) {
            Option::Some(b) => {
                Vec::push(&mut bytes, b);
            }
            Option::None => {
                return String::new();
            }
        }
        i = i + 1;
    }
    match String::from_utf8(bytes) {
        Option::Some(out) => {
            return out;
        }
        Option::None => {
            return String::new();
        }
    }
}

pub fn starts_with(s: &String, prefix: &String) -> bool {
    let n: int = String::len(s);
    let m: int = String::len(prefix);
    if m > n {
        return false;
    }
    let mut i: int = 0;
    while i < m {
        match String::get(s, i) {
            Option::Some(a) => {
                match String::get(prefix, i) {
                    Option::Some(b) => {
                        if a != b {
                            return false;
                        }
                    }
                    Option::None => {
                        return false;
                    }
                }
            }
            Option::None => {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

pub fn ends_with(s: &String, suffix: &String) -> bool {
    let n: int = String::len(s);
    let m: int = String::len(suffix);
    if m > n {
        return false;
    }
    let mut i: int = 0;
    while i < m {
        match String::get(s, n - m + i) {
            Option::Some(a) => {
                match String::get(suffix, i) {
                    Option::Some(b) => {
                        if a != b {
                            return false;
                        }
                    }
                    Option::None => {
                        return false;
                    }
                }
            }
            Option::None => {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

pub fn contains(s: &String, needle: &String) -> bool {
    let n: int = String::len(s);
    let m: int = String::len(needle);
    if m == 0 {
        return true;
    }
    if m > n {
        return false;
    }
    let mut i: int = 0;
    while i + m <= n {
        let mut j: int = 0;
        let mut same: bool = true;
        while j < m {
            match String::get(s, i + j) {
                Option::Some(a) => {
                    match String::get(needle, j) {
                        Option::Some(b) => {
                            if a != b {
                                same = false;
                            }
                        }
                        Option::None => {
                            same = false;
                        }
                    }
                }
                Option::None => {
                    same = false;
                }
            }
            j = j + 1;
        }
        if same {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn is_ascii_space(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

pub fn trim_ascii(s: &String) -> String {
    let n: int = String::len(s);
    let mut start: int = 0;
    while start < n {
        match String::get(s, start) {
            Option::Some(b) => {
                if !is_ascii_space(b) {
                    break;
                }
            }
            Option::None => {
                break;
            }
        }
        start = start + 1;
    }
    let mut end: int = n;
    while end > start {
        match String::get(s, end - 1) {
            Option::Some(b) => {
                if !is_ascii_space(b) {
                    break;
                }
            }
            Option::None => {
                break;
            }
        }
        end = end - 1;
    }
    return slice(s, start, end);
}

pub struct Split {
    head: String;
    tail: String;
}

pub fn split_once(s: &String, sep: u8) -> Option<Split> {
    let n: int = String::len(s);
    let mut i: int = 0;
    while i < n {
        match String::get(s, i) {
            Option::Some(b) => {
                if b == sep {
                    let head: String = slice(s, 0, i);
                    let tail: String = slice(s, i + 1, n);
                    return Option::Some(Split { head: head, tail: tail });
                }
            }
            Option::None => {
                return Option::None;
            }
        }
        i = i + 1;
    }
    return Option::None;
}
