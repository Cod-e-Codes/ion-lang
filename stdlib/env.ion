import "result.ion" as result;
import "option.ion" as option;

extern "C" {
    fn ion_env_copy(name: *u8, buf: *u8, cap: int) -> int;
}

pub enum EnvError {
    Missing;
    NotAscii;
}

pub fn get(name: String) -> Result<String, EnvError> {
    let mut buf: [u8; 256] = [0; 256];
    let mut n: int = 0;
    unsafe {
        n = ion_env_copy(name.data, &buf[0], 256);
    }
    if n < 0 {
        return Result::Err(EnvError::Missing);
    }
    let mut bytes: Vec<u8> = Vec::new();
    let mut i: int = 0;
    while i < n {
        if buf[i] > 127 {
            return Result::Err(EnvError::NotAscii);
        }
        Vec::push(&mut bytes, buf[i]);
        i = i + 1;
    }
    match String::from_utf8(bytes) {
        Option::Some(out) => {
            return Result::Ok(out);
        }
        Option::None => {
            return Result::Err(EnvError::NotAscii);
        }
    }
}
