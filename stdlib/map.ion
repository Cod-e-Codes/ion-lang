import "option.ion" as option;
import "hash.ion" as hash;
import "iter.ion" as iter;

pub enum Slot<K, V> {
    Empty;
    Tomb;
    Full { key: K, value: V };
}

pub struct HashMap<K, V> {
    slots: Vec<Slot<K, V>>;
    len: int;
    used: int;
    cap: int;
}

enum SetResult {
    Ok;
    OutOfBounds;
}

pub fn new<K, V>() -> HashMap<K, V> {
    let mut slots: Vec<Slot<K, V>> = Vec::new();
    let mut i: int = 0;
    while i < 16 {
        Vec::push(&mut slots, Slot::Empty);
        i = i + 1;
    }
    return HashMap { slots: slots, len: 0, used: 0, cap: 16 };
}

fn place<K: Hash + Eq, V>(slots: &mut Vec<Slot<K, V>>, cap: int, key: K, value: V) -> int {
    let h: int = key.hash();
    let mut n: int = 0;
    let mut first_tomb: int = -1;
    while n < cap {
        let mut idx: int = (h + n) % cap;
        if idx < 0 {
            idx = idx + cap;
        }
        let mut kind: int = 0;
        match Vec::get_ref(slots, idx) {
            Option::Some(slot) => {
                match slot {
                    Slot::Empty => {
                        kind = 1;
                    }
                    Slot::Tomb => {
                        kind = 2;
                    }
                    Slot::Full { key: found, value: _old } => {
                        if found == &key {
                            kind = 3;
                        } else {
                            kind = 4;
                        }
                    }
                }
            }
            Option::None => {
                return -1;
            }
        }
        if kind == 1 {
            let mut dest: int = idx;
            if first_tomb >= 0 {
                dest = first_tomb;
            }
            let _ = Vec::set(slots, dest, Slot::Full { key: key, value: value });
            if dest != idx {
                return 2;
            }
            return 1;
        }
        if kind == 2 {
            if first_tomb < 0 {
                first_tomb = idx;
            }
        }
        if kind == 3 {
            let _ = Vec::set(slots, idx, Slot::Full { key: key, value: value });
            return 0;
        }
        n = n + 1;
    }
    if first_tomb >= 0 {
        let _ = Vec::set(slots, first_tomb, Slot::Full { key: key, value: value });
        return 2;
    }
    return -1;
}

fn grow<K: Hash + Eq, V>(map: &mut HashMap<K, V>) {
    let new_cap: int = map.cap * 2;
    let mut bigger: Vec<Slot<K, V>> = Vec::new();
    let mut i: int = 0;
    while i < new_cap {
        Vec::push(&mut bigger, Slot::Empty);
        i = i + 1;
    }
    i = 0;
    while i < map.cap {
        let mut live: int = 0;
        match Vec::get_ref(map.slots, i) {
            Option::Some(slot) => {
                match slot {
                    Slot::Full { key: _k, value: _v } => {
                        live = 1;
                    }
                    Slot::Empty => {}
                    Slot::Tomb => {}
                }
            }
            Option::None => {}
        }
        if live == 1 {
            let taken: Option<Slot<K, V>> = Vec::get(map.slots, i);
            match taken {
                Option::Some(slot) => {
                    match slot {
                        Slot::Full { key: k, value: v } => {
                            let _ = place(&mut bigger, new_cap, k, v);
                        }
                        Slot::Empty => {}
                        Slot::Tomb => {}
                    }
                }
                Option::None => {}
            }
        }
        i = i + 1;
    }
    map.slots = bigger;
    map.cap = new_cap;
    map.used = map.len;
}

pub fn insert<K: Hash + Eq, V>(map: &mut HashMap<K, V>, key: K, value: V) {
    if map.used * 2 >= map.cap {
        grow(map);
    }
    let kind: int = place(map.slots, map.cap, key, value);
    if kind == 1 {
        map.len = map.len + 1;
        map.used = map.used + 1;
    } else if kind == 2 {
        map.len = map.len + 1;
    }
}

pub fn remove<K: Hash + Eq, V>(map: &mut HashMap<K, V>, key: K) -> Option<V> {
    let cap: int = map.cap;
    let h: int = key.hash();
    let mut n: int = 0;
    while n < cap {
        let mut idx: int = (h + n) % cap;
        if idx < 0 {
            idx = idx + cap;
        }
        let mut hit: int = 0;
        match Vec::get_ref(map.slots, idx) {
            Option::Some(slot) => {
                match slot {
                    Slot::Empty => {
                        return Option::None;
                    }
                    Slot::Tomb => {}
                    Slot::Full { key: found, value: _old } => {
                        if found == &key {
                            hit = 1;
                        }
                    }
                }
            }
            Option::None => {
                return Option::None;
            }
        }
        if hit == 1 {
            let taken: Option<Slot<K, V>> = Vec::get(map.slots, idx);
            match taken {
                Option::Some(slot) => {
                    match slot {
                        Slot::Full { key: _found, value: old } => {
                            let _ = Vec::set(map.slots, idx, Slot::Tomb);
                            map.len = map.len - 1;
                            return Option::Some(old);
                        }
                        Slot::Empty => {
                            return Option::None;
                        }
                        Slot::Tomb => {
                            return Option::None;
                        }
                    }
                }
                Option::None => {
                    return Option::None;
                }
            }
        }
        n = n + 1;
    }
    return Option::None;
}

pub fn len<K, V>(map: &HashMap<K, V>) -> int {
    return map.len;
}

pub fn for_each<K, V>(map: &mut HashMap<K, V>, f: fn(&V) -> int) {
    let cap: int = map.cap;
    let mut i: int = 0;
    while i < cap {
        match Vec::get_ref(map.slots, i) {
            Option::Some(slot) => {
                match slot {
                    Slot::Full { key: _k, value: v } => {
                        f(v);
                    }
                    Slot::Empty => {}
                    Slot::Tomb => {}
                }
            }
            Option::None => {}
        }
        i = i + 1;
    }
}

pub struct MapIter<K, V> {
    slots: Vec<Slot<K, V>>;
    len: int;
    used: int;
    cap: int;
}

impl<K, V> Iter<(K, V)> for MapIter<K, V> {
    fn next(self: &mut MapIter<K, V>) -> Option<(K, V)> {
        loop {
            let taken: Option<Slot<K, V>> = Vec::pop(self.slots);
            match taken {
                Option::None => {
                    return Option::None;
                }
                Option::Some(slot) => {
                    match slot {
                        Slot::Full { key: k, value: v } => {
                            return Option::Some((k, v));
                        }
                        Slot::Empty => {}
                        Slot::Tomb => {}
                    }
                }
            }
        }
    }
}

pub fn into_iter<K, V>(map: HashMap<K, V>) -> MapIter<K, V> {
    return MapIter {
        slots: map.slots,
        len: map.len,
        used: map.used,
        cap: map.cap,
    };
}

