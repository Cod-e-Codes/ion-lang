pub enum ReadResult {
    Ok(String);
    Err(int);
}

enum Option<T> {
    Some(T);
    None;
}

extern "C" {
    fn open(path: *u8, flags: int) -> int;
    fn read(fd: int, buf: *u8, count: int) -> int;
    fn close(fd: int) -> int;
}

// Read an entire file into an owned String.
// Returns Err(-1) on open failure, Err(-2) on read failure,
// Err(-3) if the file is not well-formed UTF-8, Ok(s) on success.
// flags 0 is O_RDONLY on POSIX and MinGW.
pub fn read_to_string_result(path: String) -> ReadResult {
    unsafe {
        let fd: int = open(path.data, 0);
        if fd < 0 {
            return ReadResult::Err(-1);
        }

        let mut bytes: Vec<u8> = Vec::new();
        let mut buf: [u8; 256] = [0; 256];
        let mut n: int = read(fd, &buf[0], 256);
        while n > 0 {
            let mut i: int = 0;
            while i < n {
                Vec::push(&mut bytes, buf[i]);
                i = i + 1;
            }
            n = read(fd, &buf[0], 256);
        }

        if n < 0 {
            let _closed: int = close(fd);
            return ReadResult::Err(-2);
        }

        let _closed: int = close(fd);
        match String::from_utf8(bytes) {
            Option::Some(text) => {
                return ReadResult::Ok(text);
            }
            Option::None => {
                return ReadResult::Err(-3);
            }
        }
    }
}
